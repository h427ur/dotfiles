// Gram settings
//
// For information on how to configure Gram, see the Gram
// documentation: gram://docs/configuring-gram
//
// To see all of Gram's default settings without changing your
// custom settings, run `gram: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "dap": {
    "CodeLLDB": {
      "allow_binary_download": true
    },
    "Debugpy": {
      "allow_binary_download": true
    },
    "JavaScript": {
      "allow_binary_download": true
    },
    "GDB": {
      "allow_binary_download": true
    },
    "Delve": {
      "allow_binary_download": true
    }
  },
  "project_panel": {
    "file_icons": true,
    "folder_icons": true,
  },
  "buffer_line_height": "comfortable",
  "outline_panel": {
    "dock": "right",
  },
  "node": {
    "allow_npm_install": true,
    "allow_prettier_download": true,
    "allow_binary_download": true,
  },
  "lsp": {
    "tombi": {
      "binary": {
        "allow_binary_download": true
      },
      "enable_lsp_tasks": true
    },
    "rust-analyzer": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "cmake": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "clangd": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "package-version-server": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "json-language-server": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "ruff": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "basedpyright": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "roslyn": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "csharp-ls": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "omnisharp": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
    "lua-language-server": {
      "binary": {
        "allow_binary_download": true,
      },
      "enable_lsp_tasks": true,
    },
  },
  "icon_theme": "Material Icon Theme",
  "base_keymap": "VSCode",
  "autosave": "on_focus_change",
  "ui_font_family": "Pretendard JP Variable",
  "ui_font_size": 16,
  "buffer_font_family": "Pixel Code",
  "buffer_font_size": 16.0,
  "buffer_font_features": {
    "calt": true,
  },
  "buffer_font_fallbacks": ["GalmuriMono11", "JetBrainsMonoNL Nerd Font"],
  "terminal": {
    "font_size": 14.0,
    "font_family": "Pixel Code",
    "font_features": {
      "calt": true,
    },
    "font_fallbacks": ["GalmuriMono9", "JetBrainsMonoNL Nerd Font"],
  },
  "theme": "Ayu Dark",
  "cursor_shape": "block",
}
